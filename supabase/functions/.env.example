# Local Edge Function secrets. Never commit real values.
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
SITE_URL=http://localhost:5500
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# by Supabase in hosted Edge Functions. Add service-role only if your setup requires it.
